# Names only. Do not commit a real key or a password.
# Sign-in uses one project URL and one anon key. Either name works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Example admin address. The live value belongs in the server environment, not in the repo.
ADMIN_EMAIL=oxbreedmanagement@gmail.com

# Server only. Never put this in the browser. Admin uses it to read unpublished submissions.
SUPABASE_SERVICE_ROLE_KEY=

# Empty means the provider is not connected and is not called.
TICKETMASTER_API_KEY=
JAMBASE_API_KEY=
MERPI_API_KEY=
GETYOURGUIDE_API_KEY=

# Optional. Server-only Foursquare Places Service Key (Bearer).
# Empty: /explore uses OpenStreetMap Overpass alone.
# Set: enrich / nearby search for hotels, restaurants, nightlife in Lagos, Accra, Calabar.
# Never expose this key to the browser. Do not commit a real value.
FOURSQUARE_API_KEY=

# Optional. Server-only self-hosted OSM endpoints. Leave unset for public mirrors.
# OVERPASS_URL is the full interpreter URL (e.g. https://overpass.example/api/interpreter).
# NOMINATIM_URL is the origin only (e.g. https://nominatim.example); code appends /search.
# Unset: three public Overpass mirrors + https://nominatim.openstreetmap.org
# OVERPASS_URL=
# NOMINATIM_URL=

# Optional. Server-only support chat. Prefer OpenAI when both are set.
# Leave empty so the chat still opens with FAQ / Visa and entry / List an event.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
