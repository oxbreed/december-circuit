# Names only. Do not commit a real key or a password.
# Sign-in uses one project URL and one anon key. Either name works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Cross-device My Trip sync uses the same Supabase project (migration 20261116120000_trip_lists.sql).
# Optional explicit database URL — if unset, sync follows SUPABASE_URL / NEXT_PUBLIC_SUPABASE_URL.
TRIP_DATABASE_URL=
# DATABASE_URL=

# Comma-separated admin addresses for /admin. ADMIN_EMAIL (a single address) is also read.
# dirtydecember411@gmail.com is always allowed; these variables add more addresses.
# The live values belong in the server environment, not in the repo.
ADMIN_EMAILS=dirtydecember411@gmail.com
# ADMIN_EMAIL=

# Server only. Never put this in the browser. Admin uses it to read unpublished submissions.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Shared secret for POST /api/wp-probes/ingest from proxy.ts.
# Generate a long random string. Leave empty to keep stdout-only probe logging.
# Never expose this to the browser.
WP_PROBE_INGEST_SECRET=

# Optional. First-party page views + Web Vitals need SUPABASE_SERVICE_ROLE_KEY
# and migrations 20261025120000_page_views.sql + 20261025123000_web_vitals.sql.
# Leave unset or "true" to allow inserts when the service role is present.
# Set to "false" to skip first-party storage (Vercel Analytics still runs).
# SITE_PAGEVIEWS_ENABLED=

# Optional. Google Analytics Measurement ID (G-…). Off by default.
# Do not set unless Ox Management deliberately enables GA. Site works without it.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Empty means the provider is not connected and is not called.
TICKETMASTER_API_KEY=
JAMBASE_API_KEY=
MERPI_API_KEY=
GETYOURGUIDE_API_KEY=

# Optional. Server-only Foursquare Places Service Key (Bearer).
# Empty: /explore uses OpenStreetMap Overpass alone.
# Set: enrich / nearby search for hotels, restaurants, short stays, shops, car hire,
# nightlife, landmarks in Lagos, Accra, Calabar (kinds with mapped Foursquare category IDs).
# Never expose this key to the browser. Do not commit a real value.
FOURSQUARE_API_KEY=

# Optional. Server-only Google Places API (New) key for Explore enrichment.
# Empty: /explore stays on Overpass (+ optional Foursquare). Behaviour unchanged without a key.
# Set: Nearby/Text Search for hotels (lodging), restaurants, short_stays (extended_stay_hotel),
# shops (mall/department/supermarket), car_rental, car_shops (dealer/repair), clubs
# (night_club / bar) in Lagos, Accra, Calabar — third-party map data only, with attribution.
# Landmarks stay OSM (± FSQ).
# Prefer GOOGLE_PLACES_API_KEY. GOOGLE_MAPS_API_KEY is accepted as an alias if Places is unset.
# Enable Places API (New) in Google Cloud, restrict the key, never expose to the browser.
# Do not scrape Google Maps or Airbnb. Do not commit a real value.
# See places-category-ingest.md / google-places-hotels.md in the project store.
GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=

# Optional. Server-only self-hosted OSM endpoints. Leave unset for public mirrors.
# OVERPASS_URL is the full interpreter URL (e.g. https://overpass.example/api/interpreter).
# NOMINATIM_URL is the origin only (e.g. https://nominatim.example); code appends /search.
# Unset: three public Overpass mirrors + https://nominatim.openstreetmap.org
# OVERPASS_URL=
# NOMINATIM_URL=

# Optional. Server-only driving-time estimates between two event pins on /map.
# Prefer OPENROUTESERVICE_API_KEY (OpenRouteService). MAPBOX_ACCESS_TOKEN or
# MAPBOX_DIRECTIONS_ACCESS_TOKEN also works for Mapbox Directions.
# Unset: the map shows “routing key not set” and an outbound OpenStreetMap route link only.
# OPENROUTESERVICE_API_KEY=
# MAPBOX_ACCESS_TOKEN=

# Optional. Server-only support chat. Prefer OpenAI when both are set.
# Leave empty so the chat still opens with FAQ / Visa and entry / List an event.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Affiliate partner IDs for /go/<partner> redirects (server only).
# Empty: for Agoda and Booking.com the link opens the partner's normal public
# search, is labelled as a plain outbound search, and clicks are logged with
# earning=false. Trip.com and Viator use public defaults in app/affiliate-config.ts
# when their vars are unset (Trip.com Allianceid 11268503 / SID 335386234;
# Viator pid P00333160 / mcid 66722); set them only to override. Never invent
# an ID — copy it from the partner dashboard after approval. Values are read at
# build time for labels, so redeploy after changing them.
# Trip.com Affiliate: overrides the in-code defaults.
TRIPCOM_ALLIANCE_ID=
TRIPCOM_SID=
# Agoda Partners site id (cid).
AGODA_CID=
# Booking.com affiliate id (aid).
BOOKING_AID=
# Viator Partner Program: overrides the in-code defaults (pid, mcid; medium=link is set in code).
VIATOR_PID=
VIATOR_MCID=

# Optional. Payment pages for agreed featured-placement quotes, shown on /get-featured#pay.
# Only https links on paystack.com / paystack.shop or flutterwave.com are accepted.
# Empty: no pay buttons are shown. No prices are set in code.
PAYSTACK_PAYMENT_URL=
FLUTTERWAVE_PAYMENT_URL=

# Outbound click log (/go/ redirects, ticket and sponsor clicks) uses
# SUPABASE_SERVICE_ROLE_KEY and migration 20261119120000_outbound_clicks.sql.
# SITE_PAGEVIEWS_ENABLED=false also turns click storage off.

# Optional. Local `next start` hides /preview pages unless this is set (1/true).
# Not required for `next dev` or Vercel preview deployments. Ignored when
# VERCEL_ENV=production, where /preview always returns 404.
# ALLOW_PREVIEW_ROUTES=


# Ask support messages are stored in Supabase (migration
# 20261121140000_support_requests.sql). There is no outbound mail provider
# wired for automatic notifications; the team reads the admin Support inbox
# and replies by email.
# Optional. In local development, messages can be stored in /.data when the
# table is not applied. Set to 0 to turn that off, or 1 to force it on
# (including under next start).
# SUPPORT_DEV_STORE=
